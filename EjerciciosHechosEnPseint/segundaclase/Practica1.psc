Algoritmo Practica1
	Definir nota1, nota2, nota3 Como Entero
	Definir promedio , asistencia Como Real
	Escribir "Ingrese sus 3 notas"
	Leer nota1
	Leer nota2
	Leer nota3
	Escribir "Ingrese su asistencia"
	Leer asistencia
	promedio <- (nota1 + nota2 + nota3)/3
	Si promedio>=61 O asistencia> 80 Entonces
		Escribir "Aprobaste"
	SiNo
		Escribir "Reprobaste"
	FinSi
	
	
FinAlgoritmo
